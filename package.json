{
  "name": "astro-takumi",
  "version": "2.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayxue/astro-takumi-fork.git"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@takumi-rs/core": "^2.5.6",
    "@takumi-rs/helpers": "^2.5.6",
    "jsdom": "^30.0.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@tsconfig/node20": "^20.1.9",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "astro": "^7.1.6",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "bugs": {
    "url": "https://github.com/Kayxue/astro-takumi-fork/issues"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "description": "Generate Open Graph images for your Astro site using Takumi.",
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE",
    "package-lock.json",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/vikas5914/astro-takumi",
  "keywords": [
    "takumi",
    "astro-takumi",
    "astro-integration",
    "withastro",
    "seo",
    "ui",
    "renderer"
  ],
  "license": "GPL-3.0-only",
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "printWidth": 120
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint src --cache",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest",
    "generate:presets": "mkdir -p assets/presets && npx tsx src/presets/renderExamples.ts",
    "generate:readme": "./generate_readme.sh",
    "examples:build": "npm run build && npm run build --prefix examples/preset && npm run build --prefix examples/custom"
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
