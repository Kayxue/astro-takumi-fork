{
  "name": "astro-takumi-fork-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayxue/astro-takumi-fork.git"
  },
  "bugs": {
    "url": "https://github.com/Kayxue/astro-takumi-fork/issues"
  },
  "homepage": "https://github.com/Kayxue/astro-takumi-fork",
  "license": "GPL-3.0-only",
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint packages/astro-takumi-fork/src",
    "build": "bun --filter './packages/*' build",
    "watch": "bun --filter './packages/*' watch",
    "test": "vitest",
    "generate:presets": "mkdir -p assets/presets && bun run packages/astro-takumi-fork/src/presets/renderExamples.ts",
    "generate:readme": "./generate_readme.sh",
    "examples:build": "bun --filter './packages/*' build && bun --filter './examples/*' build"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@tsconfig/node20": "^20.1.10",
    "@tsconfig/strictest": "^2.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "astro": "^7.2.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": "oxlint --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "printWidth": 120
  }
}
